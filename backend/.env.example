NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

MONGO_URI=mongodb://127.0.0.1:27017/auramart

JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://10.0.2.2:5000

PUBLIC_URL=http://localhost:5000
UPLOAD_MAX_MB=5

FREE_SHIPPING_THRESHOLD=50
SHIPPING_FLAT_RATE=9.99
TAX_RATE=0.1

SEED_ADMIN_EMAIL=admin@auramart.com
SEED_ADMIN_PASSWORD=Admin@123
