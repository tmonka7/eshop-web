NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

MONGO_URI=mongodb://127.0.0.1:27017/auramart

JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://10.0.2.2:5000

PUBLIC_URL=http://localhost:5000
UPLOAD_MAX_MB=5

FREE_SHIPPING_THRESHOLD=50
SHIPPING_FLAT_RATE=9.99
TAX_RATE=0.1

# Image search (DINOv3, runs fully offline - see ml/README.md)
VISUAL_SEARCH_ENABLED=true
VISUAL_SEARCH_MODEL_DIR=ml/dinov3-vits16
VISUAL_SEARCH_MODEL_FILE=model.onnx
VISUAL_SEARCH_THREADS=0
VISUAL_SEARCH_MIN_SCORE=0.25
VISUAL_SEARCH_INDEX_ON_BOOT=true
VISUAL_SEARCH_FETCH_REMOTE=false
# Find the product inside a photo (green box) and embed only that area
VISUAL_SEARCH_DETECT=true
VISUAL_SEARCH_DETECT_SIDE=448

SEED_ADMIN_EMAIL=admin@auramart.com
SEED_ADMIN_PASSWORD=Admin@123
