{
  "name": "auramart-backend",
  "version": "1.0.0",
  "private": true,
  "description": "ShopWorld e-commerce REST API (Node 18.19 + Express + MongoDB 6.0)",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.19.0 <19"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seed/seed.js",
    "model:fetch": "node src/scripts/fetch-model.js",
    "model:sam2": "node src/scripts/fetch-model.js --sam2",
    "visual:reindex": "node src/scripts/reindex-visual.js",
    "lint": "eslint src --ext .js",
    "test": "node --test test/"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^3.3.7",
    "onnxruntime-node": "^1.22.0",
    "sharp": "^0.34.5",
    "slugify": "^1.6.6"
  },
  "optionalDependencies": {
    "faiss-node": "^0.5.1"
