<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors the storefront's design tokens so the app and the web store read as
     one brand: green primary, red kept back for sale flags and destructive
     actions, and neutrals carrying a trace of green. -->
<resources>
    <!-- Split the same way as the web design system. `primary` is green
         UNDER white text or a white glyph: #158741 is the lightest step that
         still clears 4.5:1 with white (4.59:1). `primary_ink` is green AS
         text, which also sits on primary_light and on the tinted background,
         where the fill step only reaches 4.18-4.32:1. -->
    <color name="primary">#158741</color>
    <color name="primary_dark">#15803D</color>
    <color name="primary_ink">#15803D</color>
    <color name="primary_light">#DCFCE7</color>
    <color name="primary_surface">#F0FDF4</color>
    <!-- Only for large fills such as the splash gradient: white sits at
         3.30:1 on this step, which clears the 3:1 for a graphic but not the
         4.5:1 that any label would need. -->
    <color name="primary_bright">#16A34A</color>

    <!-- A deeper teal, so an "ok" badge never looks like a primary button. -->
    <color name="success">#0D9488</color>
    <color name="success_dark">#0F766E</color>
    <color name="success_light">#CCFBF1</color>
    <color name="success_surface">#F0FDFA</color>

    <color name="warning">#F59E0B</color>
    <color name="warning_dark">#D97706</color>
    <color name="warning_surface">#FFFBEB</color>

    <color name="info">#3B82F6</color>
    <color name="info_dark">#2563EB</color>
    <color name="info_surface">#EFF6FF</color>

    <color name="purple">#8B5CF6</color>
    <color name="purple_surface">#F5F3FF</color>

    <!-- Accent scale: discount flags, errors, destructive actions. -->
    <color name="danger">#EF4444</color>
    <color name="danger_dark">#DC2626</color>
    <color name="danger_light">#FEE2E2</color>
    <color name="danger_surface">#FEF2F2</color>

    <color name="ink_900">#0B1F14</color>
    <color name="ink_800">#14341F</color>
    <color name="ink_700">#2F4A3A</color>
    <color name="ink_600">#4B6557</color>
    <color name="ink_500">#5A7566</color>
    <color name="ink_400">#9AB0A3</color>
    <color name="ink_300">#C7D8CD</color>
    <color name="ink_200">#E2ECE6</color>
    <color name="ink_100">#EFF6F1</color>
    <color name="ink_50">#F7FBF8</color>

    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>

    <color name="text_primary">#0B1F14</color>
    <color name="text_secondary">#5A7566</color>
    <color name="divider">#E2ECE6</color>
    <color name="surface">#FFFFFF</color>
    <color name="background">#F2FAF5</color>
</resources>
