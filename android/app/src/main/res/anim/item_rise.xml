<?xml version="1.0" encoding="utf-8"?>
<!-- A list item arriving: up from below, fading and settling from slightly
     under size. Driven by layout_animation_rise.xml, not used directly. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/decelerate_interpolator"
    android:duration="320">

    <translate android:fromYDelta="12%p" android:toYDelta="0" />
    <alpha android:fromAlpha="0.0" android:toAlpha="1.0" />
    <scale
        android:fromXScale="0.96" android:toXScale="1.0"
        android:fromYScale="0.96" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="50%" />
</set>
