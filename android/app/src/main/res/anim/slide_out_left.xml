<?xml version="1.0" encoding="utf-8"?>
<!-- The outgoing screen only travels a fraction of the width, so it reads as
     being pushed rather than thrown off-screen. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/accelerate_interpolator"
    android:duration="260">
    <translate android:fromXDelta="0" android:toXDelta="-28%p" />
    <alpha android:fromAlpha="1.0" android:toAlpha="0.75" />
</set>
