<?xml version="1.0" encoding="utf-8"?>
<!-- Presses lift the card and shrink it a touch, so a tap on a product tile
     reads the same way the storefront's hover does. Applied through
     android:stateListAnimator on the card styles. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <set>
            <objectAnimator
                android:propertyName="scaleX" android:valueTo="0.97"
                android:valueType="floatType" android:duration="110"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
            <objectAnimator
                android:propertyName="scaleY" android:valueTo="0.97"
                android:valueType="floatType" android:duration="110"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
            <objectAnimator
                android:propertyName="translationZ" android:valueTo="8dp"
                android:valueType="floatType" android:duration="110" />
        </set>
    </item>

    <item>
        <set>
            <objectAnimator
                android:propertyName="scaleX" android:valueTo="1.0"
                android:valueType="floatType" android:duration="180"
                android:interpolator="@android:anim/overshoot_interpolator" />
            <objectAnimator
                android:propertyName="scaleY" android:valueTo="1.0"
                android:valueType="floatType" android:duration="180"
                android:interpolator="@android:anim/overshoot_interpolator" />
            <objectAnimator
                android:propertyName="translationZ" android:valueTo="0dp"
                android:valueType="floatType" android:duration="180" />
        </set>
    </item>
</selector>
